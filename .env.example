# development | production (production requires SECRET_KEY and sends HSTS + Secure cookies)
APP_ENV=development
SECRET_KEY=
# One Postgres shared with the SLIM ecosystem; SQLite works for quick local runs.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/slim
# SLIM reference tables (customers, chemicals, elements, analyses). Defaults to DATABASE_URL.
# Use the OSS demo data (scripts/seed_demo.py) -- never point a dev setup at the lab's database.
# SLIM_DATABASE_URL=
# REFERENCE_CACHE_TTL_SECONDS=300
# Optional overrides
# SESSION_COOKIE_SECURE=true
# SESSION_MAX_AGE_SECONDS=28800
# MAX_BODY_BYTES=1048576
